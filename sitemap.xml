<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">

  <!-- STATIC PAGES — only edit this list when you add a NEW calculator/page -->
  <url><loc>{{ '/' | absolute_url }}</loc></url>
  <url><loc>{{ '/calculators/' | absolute_url }}</loc></url>
  <url><loc>{{ '/gpa-calculator/' | absolute_url }}</loc></url>
  <url><loc>{{ '/cgpa-calculator/' | absolute_url }}</loc></url>
  <url><loc>{{ '/grade-calculator/' | absolute_url }}</loc></url>
  <url><loc>{{ '/final-grade-calculator/' | absolute_url }}</loc></url>
  <url><loc>{{ '/attendance-calculator/' | absolute_url }}</loc></url>
  <url><loc>{{ '/class-rank-calculator/' | absolute_url }}</loc></url>
  <url><loc>{{ '/student-loan-calculator/' | absolute_url }}</loc></url>
  <url><loc>{{ '/scholarship-calculator/' | absolute_url }}</loc></url>
  <url><loc>{{ '/study-time-planner/' | absolute_url }}</loc></url>
  <url><loc>{{ '/essay-word-counter/' | absolute_url }}</loc></url>
  <url><loc>{{ '/lsac-gpa-calculator/' | absolute_url }}</loc></url>
  <url><loc>{{ '/calculator-methodology/' | absolute_url }}</loc></url>
  <url><loc>{{ '/blog/' | absolute_url }}</loc></url>
  <url><loc>{{ '/about-us/' | absolute_url }}</loc></url>
  <url><loc>{{ '/contact-us/' | absolute_url }}</loc></url>
  <url><loc>{{ '/privacy-policy/' | absolute_url }}</loc></url>
  <url><loc>{{ '/disclaimer/' | absolute_url }}</loc></url>

  <!-- BLOG POSTS — AUTOMATIC. Every new post in _posts/ appears here with no edits. -->
  {% for post in site.posts %}
  <url>
    <loc>{{ post.url | absolute_url }}</loc>
    <lastmod>{{ post.date | date_to_xmlschema }}</lastmod>
  </url>
  {% endfor %}

</urlset>
